    margin-top: 28px;
    margin-bottom: 10px;
  }
  h3 {
    font-size: 13pt;
    color: #0369a1;
    margin-top: 16px;
    margin-bottom: 6px;
  }
  p {
    margin-top: 4px;
    margin-bottom: 8px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    margin-top: 8px;
    margin-bottom: 16px;
  }
  th {
    background-color: #0284c7;
    color: #ffffff;
    font-weight: bold;
