  }
  h1 {
    font-size: 22pt;
    color: #0284c7;
    border-bottom: 2pt solid #0284c7;
    padding-bottom: 6px;
    margin-bottom: 10px;
  }
  h2 {
    font-size: 15pt;
    color: #0f172a;
    border-bottom: 1pt solid #cbd5e1;
    padding-bottom: 4px;
    margin-top: 24px;
    margin-bottom: 10px;
  }
  h3 {
    font-size: 12.5pt;
    color: #0369a1;
    margin-top: 18px;
    margin-bottom: 6px;
  }
  p {
    margin-top: 4px;
    margin-bottom: 8px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    margin-top: 8px;
    margin-bottom: 14px;
  }
  th {
    background-color: #0284c7;
    color: #ffffff;
    font-weight: bold;
    text-align: left;
    padding: 8px 10px;
    border: 1px solid #0284c7;
    font-size: 10pt;
  }
